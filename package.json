{
  "name": "tero-backend",
  "version": "1.0.0",
  "description": "Tero Network - Backend API + Database (built from scratch to match the existing frontend)",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
